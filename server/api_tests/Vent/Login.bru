script:post-response {
  const data = res.getBody();
  
  bru.setEnvVar("jwt_access_token", data.access_token);
  bru.setEnvVar("jwt_refresh_token", data.refresh_token);
}

settings {
  encodeUrl: true
  timeout: 0
}
